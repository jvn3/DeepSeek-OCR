"""
Supabase JWT authentication and authorization.

Verifies Supabase JWTs using JWKS discovery and enforces rate limiting.
"""
import time
import logging
from typing import Optional, Dict, Any
from functools import lru_cache
import httpx
from jose import jwt, JWTError
from fastapi import HTTPException, Security, Request
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_429_TOO_MANY_REQUESTS

from models.schemas import ErrorCode

logger = logging.getLogger(__name__)

security = HTTPBearer()


class SupabaseAuth:
    """Supabase JWT authentication handler."""
    
    def __init__(
        self,
        supabase_url: str,
        jwt_secret: Optional[str] = None,
        use_jwks: bool = True
    ):
        """
        Initialize Supabase authentication.
        
        Args:
            supabase_url: Supabase project URL
            jwt_secret: JWT secret (for HS256, alternative to JWKS)
            use_jwks: Whether to use JWKS discovery (recommended)
        """
        self.supabase_url = supabase_url.rstrip('/')
        self.jwt_secret = jwt_secret
        self.use_jwks = use_jwks
        self.jwks_url = f"{self.supabase_url}/auth/v1/.well-known/jwks.json"
        
        # Rate limiting storage (in-memory, use Redis for production)
        self._rate_limits: Dict[str, list] = {}
        self._ip_rate_limits: Dict[str, list] = {}
    
    @lru_cache(maxsize=1)
    def _get_jwks(self) -> Dict[str, Any]:
        """Fetch JWKS from Supabase (cached)."""
        try:
            response = httpx.get(self.jwks_url, timeout=5.0)
            response.raise_for_status()
            return response.json()
        except Exception as e:
            logger.error(f"Failed to fetch JWKS: {e}")
            raise HTTPException(
                status_code=HTTP_401_UNAUTHORIZED,
                detail="Failed to fetch authentication keys"
            )
    
    def verify_token(self, token: str) -> Dict[str, Any]:
        """
        Verify and decode a Supabase JWT.
        
        Args:
            token: JWT token string
            
        Returns:
            Decoded token payload
            
        Raises:
            HTTPException: If token is invalid or expired
        """
        try:
            if self.use_jwks:
                # Verify using JWKS
                jwks = self._get_jwks()
                
                # Decode without verification first to get the header
                unverified_header = jwt.get_unverified_header(token)
                
                # Find the matching key
                rsa_key = None
                for key in jwks.get("keys", []):
                    if key["kid"] == unverified_header.get("kid"):
                        rsa_key = {
                            "kty": key["kty"],
                            "kid": key["kid"],
                            "use": key["use"],
                            "n": key["n"],
                            "e": key["e"]
                        }
                        break
                
                if not rsa_key:
                    raise HTTPException(
                        status_code=HTTP_401_UNAUTHORIZED,
                        detail="Unable to find matching key"
                    )
                
                # Verify and decode
                payload = jwt.decode(
                    token,
                    rsa_key,
                    algorithms=["RS256"],
                    audience="authenticated",
                    options={"verify_aud": False}  # Supabase uses different audiences
                )
            else:
                # Verify using shared secret (HS256)
                payload = jwt.decode(
                    token,
                    self.jwt_secret,
                    algorithms=["HS256"],
                    options={"verify_aud": False}
                )
            
            return payload
            
        except JWTError as e:
            logger.warning(f"JWT verification failed: {e}")
            raise HTTPException(
                status_code=HTTP_401_UNAUTHORIZED,
                detail=f"Invalid authentication token: {str(e)}"
            )
    
    def check_rate_limit(
        self,
        user_id: str,
        client_ip: str,
        max_requests_per_minute: int = 60,
        max_requests_per_minute_per_ip: int = 100
    ) -> None:
        """
        Check rate limits for user and IP.
        
        Args:
            user_id: User identifier from JWT (sub claim)
            client_ip: Client IP address
            max_requests_per_minute: Per-user limit
            max_requests_per_minute_per_ip: Per-IP limit
            
        Raises:
            HTTPException: If rate limit exceeded
        """
        current_time = time.time()
        cutoff_time = current_time - 60  # 1 minute window
        
        # Clean old entries and check user rate limit
        if user_id in self._rate_limits:
            self._rate_limits[user_id] = [
                t for t in self._rate_limits[user_id] if t > cutoff_time
            ]
            
            if len(self._rate_limits[user_id]) >= max_requests_per_minute:
                retry_after = int(60 - (current_time - self._rate_limits[user_id][0]))
                raise HTTPException(
                    status_code=HTTP_429_TOO_MANY_REQUESTS,
                    detail={
                        "error": ErrorCode.RATE_LIMITED,
                        "message": f"Rate limit exceeded for user. Try again in {retry_after}s",
                        "retry_after": retry_after
                    }
                )
        else:
            self._rate_limits[user_id] = []
        
        # Clean old entries and check IP rate limit
        if client_ip in self._ip_rate_limits:
            self._ip_rate_limits[client_ip] = [
                t for t in self._ip_rate_limits[client_ip] if t > cutoff_time
            ]
            
            if len(self._ip_rate_limits[client_ip]) >= max_requests_per_minute_per_ip:
                retry_after = int(60 - (current_time - self._ip_rate_limits[client_ip][0]))
                raise HTTPException(
                    status_code=HTTP_429_TOO_MANY_REQUESTS,
                    detail={
                        "error": ErrorCode.RATE_LIMITED,
                        "message": f"Rate limit exceeded for IP. Try again in {retry_after}s",
                        "retry_after": retry_after
                    }
                )
        else:
            self._ip_rate_limits[client_ip] = []
        
        # Record this request
        self._rate_limits[user_id].append(current_time)
        self._ip_rate_limits[client_ip].append(current_time)


# Global auth instance (initialized in main app)
_auth_instance: Optional[SupabaseAuth] = None


def init_auth(supabase_url: str, jwt_secret: Optional[str] = None) -> SupabaseAuth:
    """Initialize global auth instance."""
    global _auth_instance
    _auth_instance = SupabaseAuth(supabase_url, jwt_secret)
    return _auth_instance


def get_auth() -> SupabaseAuth:
    """Get global auth instance."""
    if _auth_instance is None:
        raise RuntimeError("Auth not initialized. Call init_auth() first.")
    return _auth_instance


async def verify_jwt(
    credentials: HTTPAuthorizationCredentials = Security(security),
    request: Request = None
) -> Dict[str, Any]:
    """
    FastAPI dependency for JWT verification.
    
    Usage:
        @app.get("/protected")
        async def protected_route(user: dict = Depends(verify_jwt)):
            return {"user_id": user["sub"]}
    """
    auth = get_auth()
    payload = auth.verify_token(credentials.credentials)
    
    # Check rate limits
    user_id = payload.get("sub", "unknown")
    client_ip = request.client.host if request else "0.0.0.0"
    auth.check_rate_limit(user_id, client_ip)
    
    return payload


async def optional_jwt(request: Request) -> Optional[Dict[str, Any]]:
    """
    Optional JWT verification (for endpoints that support both authenticated and anonymous access).
    """
    auth_header = request.headers.get("Authorization")
    if not auth_header or not auth_header.startswith("Bearer "):
        return None
    
    try:
        token = auth_header.split(" ")[1]
        auth = get_auth()
        payload = auth.verify_token(token)
        
        # Check rate limits
        user_id = payload.get("sub", "unknown")
        client_ip = request.client.host if request else "0.0.0.0"
        auth.check_rate_limit(user_id, client_ip)
        
        return payload
    except Exception:
        return None
