# Production environment variables
# Copy this file to .env and fill in your values

# Service Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=deepseek-ai/DeepSeek-OCR
USE_MOCK_ADAPTER=false
DEVICE=cuda
GPU_MEMORY_UTILIZATION=0.9

# Supabase Configuration (REQUIRED for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Security
REQUIRE_E2EE=false  # Set to true to enforce E2EE for all requests
USE_JWKS=true  # Use JWKS discovery for JWT verification (recommended)

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_MINUTE_PER_IP=100

# File Limits
MAX_FILE_SIZE_MB=20
MAX_PAGE_MEGAPIXELS=25
MAX_PAGES=100

# Features
ENABLE_SSE=true
ALLOW_PDF_UPLOADS=false  # Keep false for zero-knowledge deployments

# Processing
MAX_CONCURRENCY=10

# CORS (comma-separated origins)
CORS_ORIGINS=*
